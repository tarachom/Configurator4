<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="AutomaticNumbering" parent="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <property name="margin-top">5</property>
        <property name="margin-bottom">5</property>

        <child>
            <object class="GtkExpander">
                <property name="label">Нумерація</property>
                <property name="expanded">false</property>
                
                 <child>
                    <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">10</property>
                        <property name="margin-top">10</property>

                        <!-- Заголовок -->
                        <child>
                            <object class="GtkLabel">
                                <property name="use-markup">true</property>
                                <property name="label">&lt;b&gt;Автоматична нумерація&lt;/b&gt;</property>
                                <property name="halign">center</property>
                            </object>
                        </child>

                        <child>
                            <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">10</property>
                                                        
                                <child>
                                    <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">10</property>

                                        <!-- Чекбокс -->
                                        <child>
                                            <object class="GtkCheckButton" id="check_automatic_numbering">
                                                <property name="label">Автоматична нумерація</property>
                                                <property name="halign">end</property>
                                                <property name="valign">start</property>
                                            </object>
                                        </child>

                                        <!-- Кнопка  -->
                                        <child>
                                            <object class="GtkButton" id="button_create">
                                                <property name="label">Створити константу</property>
                                                <property name="halign">start</property>
                                            </object>
                                        </child>

                                    </object>
                                </child>

                                <!-- Опис -->
                                <child>
                                    <object class="GtkLabel">
                                        <property name="use-markup">true</property>
                                        <property name="wrap">true</property>
                                        <property name="halign">start</property>
                                        <property name="valign">start</property>
                                        <property name="hexpand">true</property>
                                        <property name="label">Для автоматичної нумерації використовується константа в блоці &lt;b&gt;НумераціяДовідників&lt;/b&gt; або &lt;b&gt;НумераціяДокументів&lt;/b&gt;. 

Назва константи - це назва довідника чи документу.

Перед створенням константи - довідник або документ вже має бути збережений.</property>
                                    </object>
                                </child>

                            </object>
                        </child>

                    </object>
                </child>

            </object>
        </child>

    </template>
</interface>