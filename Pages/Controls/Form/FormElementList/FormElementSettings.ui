<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="FormElementSettings" parent="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>

        <!-- Вертикальна панель із розділювачем -->
        <child>
            <object class="GtkPaned" id="paned_main">
                <property name="orientation">vertical</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="position">500</property>

                <!-- ================= ВЕРХНЯ ПАНЕЛЬ: Поля ================= -->
                <property name="start-child">
                    <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        
                        <!-- Заголовок секції -->
                        <child>
                            <object class="GtkLabel">
                                <property name="label">Поля:</property>
                                <property name="halign">start</property>
                                <property name="margin-bottom">10</property>
                            </object>
                        </child>

                        <!-- Верхній тулбар -->
                        <child>
                            <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <style>
                                    <class name="toolbar-container" />
                                </style>
                                <child>
                                    <object class="GtkButton" id="button_fields_action">
                                        <property name="icon-name">view-sort-descending</property>
                                        <property name="tooltip-text">Дія</property>
                                        <style>
                                            <class name="toolbar" />
                                            <class name="flat" />
                                        </style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkButton" id="button_fields_up">
                                        <property name="icon-name">go-up</property>
                                        <property name="tooltip-text">Вгору</property>
                                        <style>
                                            <class name="toolbar" />
                                            <class name="flat" />
                                        </style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkButton" id="button_fields_down">
                                        <property name="icon-name">go-down</property>
                                        <property name="tooltip-text">Вниз</property>
                                        <style>
                                            <class name="toolbar" />
                                            <class name="flat" />
                                        </style>
                                    </object>
                                </child>
                            </object>
                        </child>

                        <!-- Верхній ScrolledWindow з порожнім ColumnView -->
                        <child>
                            <object class="GtkScrolledWindow">
                                <property name="hexpand">true</property>
                                <property name="vexpand">true</property>
                                <property name="child">
                                    <object class="GtkColumnView" id="column_view_fields">
                                        <property name="show-column-separators">false</property>
                                        <property name="show-row-separators">false</property>
                                    </object>
                                </property>
                            </object>
                        </child>

                    </object>
                </property>

                <!-- ================= НИЖНЯ ПАНЕЛЬ: Табличні частини ================= -->
                <property name="end-child">
                    <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-top">6</property>

                        <!-- Заголовок секції -->
                        <child>
                            <object class="GtkLabel">
                                <property name="label">Табличні частини:</property>
                                <property name="halign">start</property>
                                <property name="margin-bottom">10</property>
                            </object>
                        </child>

                        <!-- Нижній тулбар -->
                        <child>
                            <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <style>
                                    <class name="toolbar-container" />
                                </style>
                                <child>
                                    <object class="GtkButton" id="button_tabularparts_action">
                                        <property name="icon-name">view-sort-descending</property>
                                        <property name="tooltip-text">Дія</property>
                                        <style>
                                            <class name="toolbar" />
                                            <class name="flat" />
                                        </style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkButton" id="button_tabularparts_up">
                                        <property name="icon-name">go-up</property>
                                        <property name="tooltip-text">Вгору</property>
                                        <style>
                                            <class name="toolbar" />
                                            <class name="flat" />
                                        </style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkButton" id="button_tabularparts_down">
                                        <property name="icon-name">go-down</property>
                                        <property name="tooltip-text">Вниз</property>
                                        <style>
                                            <class name="toolbar" />
                                            <class name="flat" />
                                        </style>
                                    </object>
                                </child>
                            </object>
                        </child>

                        <!-- Нижній ScrolledWindow з порожнім ColumnView -->
                        <child>
                            <object class="GtkScrolledWindow">
                                <property name="hexpand">true</property>
                                <property name="vexpand">true</property>
                                <property name="child">
                                    <object class="GtkColumnView" id="column_view_tabularparts">
                                        <property name="show-column-separators">false</property>
                                        <property name="show-row-separators">false</property>
                                    </object>
                                </property>
                            </object>
                        </child>

                    </object>
                </property>

            </object>
        </child>

    </template>
</interface>