<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="RenameTableOrColumn" parent="GtkBox">
        <property name="orientation">horizontal</property>

        <!-- Кнопка, яка автоматично відкриває Popover по кліку -->
        <child>
            <object class="GtkMenuButton">
                <property name="icon-name">edit</property>
                <property name="tooltip-text">Перейменувати</property>
                
                <!-- Вкладений Popover -->
                <property name="popover">
                    <object class="GtkPopover" id="popover_rename">
                        <property name="position">bottom</property>
                        <property name="autohide">true</property>

                        <!-- Вміст спливаючого вікна -->
                        <property name="child">
                            <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">10</property>
                                <property name="margin-start">5</property>
                                <property name="margin-end">5</property>
                                <property name="margin-top">5</property>
                                <property name="margin-bottom">5</property>

                                <!-- 1. Верхній рядок: [Стара назва] → [Нова назва] [Перейменувати] -->
                                <child>
                                    <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">8</property>

                                        <!-- Стара назва -->
                                        <child>
                                            <object class="GtkEntry" id="entry_old_name">
                                                <property name="hexpand">true</property>
                                                <property name="placeholder-text">Стара назва</property>
                                                <property name="editable">false</property>
                                            </object>
                                        </child>

                                        <!-- Стрілочка -->
                                        <child>
                                            <object class="GtkLabel">
                                                <property name="label">→</property>
                                            </object>
                                        </child>

                                        <!-- Нова назва -->
                                        <child>
                                            <object class="GtkEntry" id="entry_new_name">
                                                <property name="hexpand">true</property>
                                                <property name="placeholder-text">Нова назва</property>
                                            </object>
                                        </child>

                                        <!-- Кнопка дії -->
                                        <child>
                                            <object class="GtkButton" id="button_rename">
                                                <property name="label">Перейменувати</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>

                                <!-- 2. Нижня частина: Лог (800x500) -->
                                <child>
                                    <object class="GtkScrolledWindow">
                                        <property name="width-request">600</property>
                                        <property name="height-request">500</property>
                                        <property name="has-frame">true</property>
                                        <property name="hscrollbar-policy">automatic</property>
                                        <property name="vscrollbar-policy">automatic</property>

                                        <property name="child">
                                            <object class="GtkTextView" id="textview_log">
                                                <property name="editable">false</property>
                                                <property name="cursor-visible">false</property>
                                                <property name="monospace">true</property>
                                                <property name="wrap-mode">word-char</property>
                                                <property name="left-margin">5</property>
                                                <property name="right-margin">5</property>
                                                <property name="top-margin">5</property>
                                                <property name="bottom-margin">5</property>
                                            </object>
                                        </property>
                                    </object>
                                </child>

                            </object>
                        </property>
                    </object>
                </property>
            </object>
        </child>

    </template>
</interface>