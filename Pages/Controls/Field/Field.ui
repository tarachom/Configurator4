<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="Field" parent="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <property name="margin-top">5</property>
        <property name="margin-bottom">5</property>

        <child>
            <object class="GtkGrid">
                <property name="column-spacing">10</property>
                <property name="row-spacing">8</property>

                <!-- Рядок 0: Тип -->
                <child>
                    <object class="GtkLabel">
                        <property name="label">Тип даних:</property>
                        <property name="halign">end</property>
                        <layout>
                            <property name="column">0</property>
                            <property name="row">0</property>
                        </layout>
                    </object>
                </child>
                <child>
                    <object class="DropDownControl" id="dropdown_type">
                        <property name="hexpand">true</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">0</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 1: Вказівник -->
                <child>
                    <object class="GtkLabel">
                        <property name="label">Вказівник:</property>
                        <property name="halign">end</property>
                        <layout>
                            <property name="column">0</property>
                            <property name="row">1</property>
                        </layout>
                    </object>
                </child>
                <child>
                    <object class="DropDownControl" id="dropdown_pointer">
                        <property name="hexpand">true</property>
                        <property name="sensitive">false</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">1</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 2: Перелічення -->
                <child>
                    <object class="GtkLabel">
                        <property name="label">Перелічення:</property>
                        <property name="halign">end</property>
                        <layout>
                            <property name="column">0</property>
                            <property name="row">2</property>
                        </layout>
                    </object>
                </child>
                <child>
                    <object class="DropDownControl" id="dropdown_enum">
                        <property name="hexpand">true</property>
                        <property name="sensitive">false</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">2</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 3: Індексувати -->
                <child>
                    <object class="GtkCheckButton" id="check_index">
                        <property name="label">Індексувати</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">3</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 4: Використовувати для представлення -->
                <child>
                    <object class="GtkCheckButton" id="check_presentation">
                        <property name="label">Використовувати для представлення</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">4</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 5: Повнотекстовий пошук -->
                <child>
                    <object class="GtkCheckButton" id="check_fulltext_search">
                        <property name="label">Повнотекстовий пошук</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">5</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 6: Пошук в журналах -->
                <child>
                    <object class="GtkCheckButton" id="check_journal_search">
                        <property name="label">Пошук в журналах</property>
                        <property name="active">true</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">6</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 7: Багатострічкове поле -->
                <child>
                    <object class="GtkCheckButton" id="check_multiline">
                        <property name="label">Багатострічкове поле</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">7</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 8: Автоматична нумерація та сортування -->
                <child>
                    <object class="GtkCheckButton" id="check_auto_numbering">
                        <property name="label">Автоматична нумерація та сортування</property>
                        <property name="sensitive">false</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">8</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 9: Дозволити експорт -->
                <child>
                    <object class="GtkCheckButton" id="check_allow_export">
                        <property name="label">Дозволити експорт</property>
                        <layout>
                            <property name="column">1</property>
                            <property name="row">9</property>
                        </layout>
                    </object>
                </child>

                <!-- Рядок 10: Експандер композитного типу -->
                <child>
                    <object class="GtkExpander">
                        <property name="label">Налаштування для композитного типу даних (composite_pointer)</property>
                        <property name="child">
                            <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">10</property>
                                <property name="margin-top">10</property>
                                <property name="margin-bottom">10</property>

                                <!-- Заголовок секції -->
                                <child>
                                    <object class="GtkLabel">
                                        <property name="use-markup">true</property>
                                        <property name="label">&lt;b&gt;Довідники або документи доступні для вибору&lt;/b&gt;</property>
                                        <property name="halign">center</property>
                                    </object>
                                </child>

                                <!-- Контейнер для 2 колонок (Довідники та Документи) -->
                                <child>
                                    <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">10</property>
                                        <property name="homogeneous">true</property>

                                        <!-- ДОВІДНИКИ -->
                                        <child>
                                            <object class="GtkBox">
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">10</property>

                                                <child>
                                                    <object class="GtkLabel">
                                                        <property name="label">Довідники</property>
                                                        <property name="halign">center</property>
                                                    </object>
                                                </child>

                                                <child>
                                                    <object class="GtkCheckButton" id="check_directories_not_use">
                                                        <property name="label">Не використовувати</property>
                                                        <property name="sensitive">false</property>
                                                    </object>
                                                </child>

                                                <child>
                                                    <object class="GtkScrolledWindow">
                                                        <property name="height-request">500</property>
                                                        <property name="width-request">300</property>
                                                        <property name="has-frame">true</property>
                                                        <property name="child">
                                                            <!-- ListBox для довідників -->
                                                            <object class="GtkListBox" id="listbox_directories">
                                                                <property name="selection-mode">none</property>
                                                                <property name="margin-start">5</property>
                                                                <property name="margin-end">5</property>
                                                                <property name="margin-top">5</property>
                                                                <property name="margin-bottom">5</property>
                                                                <property name="sensitive">false</property>
                                                            </object>
                                                        </property>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <!-- ДОКУМЕНТИ -->
                                        <child>
                                            <object class="GtkBox">
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">10</property>

                                                <child>
                                                    <object class="GtkLabel">
                                                        <property name="label">Документи</property>
                                                        <property name="halign">center</property>
                                                    </object>
                                                </child>

                                                <child>
                                                    <object class="GtkCheckButton" id="check_documents_not_use">
                                                        <property name="label">Не використовувати</property>
                                                        <property name="sensitive">false</property>
                                                    </object>
                                                </child>

                                                <child>
                                                    <object class="GtkScrolledWindow">
                                                        <property name="height-request">500</property>
                                                        <property name="width-request">300</property>
                                                        <property name="has-frame">true</property>
                                                        <property name="child">
                                                            <!-- ListBox для документів -->
                                                            <object class="GtkListBox" id="listbox_documents">
                                                                <property name="selection-mode">none</property>
                                                                <property name="margin-start">5</property>
                                                                <property name="margin-end">5</property>
                                                                <property name="margin-top">5</property>
                                                                <property name="margin-bottom">5</property>
                                                                <property name="sensitive">false</property>
                                                            </object>
                                                        </property>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                    </object>
                                </child>

                            </object>
                        </property>
                        <layout>
                            <property name="column">0</property>
                            <property name="row">10</property>
                            <property name="column-span">2</property>
                        </layout>
                    </object>
                </child>

            </object>
        </child>
    </template>
</interface>