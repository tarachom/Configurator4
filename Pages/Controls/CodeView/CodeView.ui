<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="CodeView" parent="GtkBox">
        <property name="orientation">vertical</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <property name="margin-top">5</property>
        <property name="margin-bottom">5</property>

        <child>
            <object class="GtkScrolledWindow">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="has-frame">true</property>
                <property name="child">
                    <object class="GtkSourceView" id="source_view">
                        <property name="show-line-numbers">true</property>      <!-- Номери рядків -->
                        <property name="show-line-marks">true</property>
                        <property name="highlight-current-line">true</property> <!-- Підсвітка активного рядка -->
                        <property name="tab-width">4</property>
                        <property name="insert-spaces-instead-of-tabs">true</property>
                        <property name="cursor-visible">true</property>
                    </object>
                </property>
            </object>
        </child>
        
    </template>
</interface>